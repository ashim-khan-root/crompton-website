---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  dir?: string;
}

const { title, description = "Reliable Manpower Solutions for Qatar's Growing Industries", lang = "en", dir = "ltr" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="generator" content={Astro.generator}>
  
  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content={lang === 'ar' ? 'ar_QA' : 'en_QA'}>
  <meta property="og:site_name" content="Crompton International">
  <meta name="theme-color" content="#1a365d">
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <title>{title} | Crompton International</title>
  
  <!-- Schema.org -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Crompton International Trading & Contracting & Services W.L.L.",
    "url": "https://crompton-intl.com",
    "logo": "https://crompton-intl.com/favicon.svg",
    "description": "Trusted manpower supply company in Qatar, providing skilled white collar and blue collar professionals to construction, engineering, and industrial sectors.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "NBK-Msheireb Buildings, 4th Floor, Office #405 & 406",
      "addressLocality": "Doha",
      "addressCountry": "QA",
      "postalCode": "37491"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+974-4468-1414",
      "contactType": "customer service",
      "availableLanguage": ["English", "Arabic"]
    }
  }
  </script>
</head>
<body class="bg-paper font-body text-ink">
  <slot />
</body>
</html>
