---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import services from '../../data/services.json';
import HeroCarousel from '../../components/HeroCarousel.astro';
import industries from '../../data/industries.json';
import { ArrowRight, Phone, ShieldCheck, Truck, GraduationCap, BedDouble } from 'lucide-react';

const capabilities = services;

const operations = [
  {
    icon: BedDouble,
    title: 'السكن',
    description: 'سكن عمال مطابق للمعايير القطرية، مع النقل بين السكن والموقع.',
    slot: 'صورة — سكن العمال، من الخارج',
    span: 'lg:col-span-7',
  },
  {
    icon: Truck,
    title: 'النقل',
    description: 'أسطول مخصص للنقل اليومي والتنقل بين المواقع.',
    slot: 'صورة — أسطول النقل في الموقع',
    span: 'lg:col-span-5',
  },
  {
    icon: GraduationCap,
    title: 'التدريب',
    description: 'تدريب مهني وتعريفي بالسلامة قبل وصول العامل إلى مشروعك.',
    slot: 'صورة — جلسة تدريب وتعريف',
    span: 'lg:col-span-5',
  },
  {
    icon: ShieldCheck,
    title: 'الصحة والسلامة',
    description: 'إجراءات صحة وسلامة متوافقة مع قوانين العمل ومتطلبات المواقع في قطر.',
    slot: 'صورة — اجتماع سلامة مع معدات الوقاية',
    span: 'lg:col-span-7',
  },
];
---

<BaseLayout
  title="الرئيسية"
  description="كرومتون جروب للتجارة والمقاولات وخدمات ش.م.م — توريد عمالة من الكوادر البيضاء والزرقاء لمشاريع البناء والهندسة والبنية التحتية في قطر."
  lang="ar"
  dir="rtl"
>
  <Navbar lang="ar" client:load />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-primary-900 pt-36 pb-20 md:pt-44 md:pb-24">
      <div class="grain absolute inset-0 grid-tex opacity-70" aria-hidden="true"></div>

      <div class="container-custom relative px-5 md:px-8 lg:px-10">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <p class="mb-7 inline-flex items-center gap-2.5 border border-white/15 px-3.5 py-1.5 text-[0.72rem] uppercase tracking-[0.18em] text-white/70">
              <span class="h-1.5 w-1.5 bg-secondary-400"></span>
              توريد عمالة &middot; الدوحة، قطر
            </p>

            <h1 class="font-heading text-[2.4rem] font-bold leading-[1.12] text-white sm:text-[3rem] lg:text-[3.6rem]">
              حلول عمالة موثوقة لقطاعات قطر النامية
            </h1>

            <p class="mt-6 max-w-measure text-[1.05rem] leading-relaxed text-white/65">
              توفّر كرومتون جروب عمالة من الكوادر البيضاء والزرقاء لقطاعات البناء والهندسة
              والبنية التحتية والمكاتب — يتم تجهيزها ونشرها إلى موقعك وفق جدولك الزمني.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a href="/en/contact" class="btn-gold">
                طلب عمالة
                <ArrowRight size={18} class="rotate-180" aria-hidden="true" />
              </a>
              <a href="tel:+97444681414" class="btn-ghost">
                <Phone size={17} aria-hidden="true" />
                <span class="tnum" dir="ltr">+974 4468 1414</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="border border-white/12 bg-white/[0.03] backdrop-blur-sm">
              <div class="border-b border-white/10 px-6 py-4">
                <h2 class="font-heading text-[0.72rem] uppercase tracking-[0.2em] text-secondary-400">
                  ما نوفّره
                </h2>
              </div>
              <ul>
                {capabilities.map((item) => (
                  <li class="flex items-baseline justify-between gap-6 border-b border-white/10 px-6 py-4 last:border-b-0">
                    <span class="font-heading text-[0.98rem] font-semibold text-white">{item.titleAr}</span>
                    <span class="shrink-0 text-[0.7rem] text-white/40">
                      {item.roles.length} مهنة
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-white/12 pt-6 text-[0.8rem] text-white/55">
          <span>مرخّصة من وزارة العمل القطرية</span>
          <span class="hidden h-3 w-px bg-white/20 sm:block"></span>
          <span>كوادر بيضاء وزرقاء</span>
          <span class="hidden h-3 w-px bg-white/20 sm:block"></span>
          <span>تعبئة حسب المشروع</span>
          <span class="hidden h-3 w-px bg-white/20 lg:block"></span>
          <span>الدوحة، قطر</span>
        </div>
      </div>
    </section>

    <!-- Hero photograph -->
    <HeroCarousel lang="ar" />

    <!-- Capabilities -->
    <section class="section-padding bg-paper">
      <div class="container-custom">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="font-heading text-[2rem] font-bold leading-tight text-primary-500 md:text-[2.3rem]">
              ما نوفّره
            </h2>
            <p class="mt-5 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
              ستّ خدمات عمالية، تُقدَّم كقدرة تجهيز واحدة. يُحدَّد النطاق بحسب مشروعك، لا وفق قائمة
              ثابتة.
            </p>
            <a
              href="/en/services"
              class="mt-7 inline-flex items-center gap-2 border-b border-primary-500 pb-1 font-heading text-[0.9rem] font-semibold text-primary-500 transition-colors duration-150 hover:border-secondary-400 hover:text-secondary-600"
            >
              جميع الخدمات
              <ArrowRight size={16} class="rotate-180" aria-hidden="true" />
            </a>
          </div>

          <div class="lg:col-span-8">
            <ul class="border-t border-rule">
              {capabilities.map((item) => (
                <li>
                  <a
                    href={`/en/services#${item.id}`}
                    class="group grid grid-cols-1 gap-2 border-b border-rule py-6 transition-colors duration-150 hover:bg-paper-2 md:grid-cols-12 md:gap-6 md:px-3"
                  >
                    <span class="font-heading text-[1.15rem] font-semibold text-primary-500 md:col-span-5">
                      {item.titleAr}
                    </span>
                    <span class="text-[0.9rem] leading-relaxed text-ink-muted md:col-span-6">
                      {item.descriptionAr}
                    </span>
                    <span class="hidden justify-self-end text-ink-faint transition-colors duration-150 group-hover:text-secondary-500 md:col-span-1 md:block">
                      <ArrowRight size={18} class="rotate-180" aria-hidden="true" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Operations -->
    <section class="section-padding bg-paper-2">
      <div class="container-custom">
        <div class="mb-12 max-w-measure">
          <h2 class="font-heading text-[2rem] font-bold leading-tight text-primary-500 md:text-[2.3rem]">
            خلف كل عملية تجهيز
          </h2>
          <p class="mt-5 text-[0.95rem] leading-relaxed text-ink-muted">
            توريد العمالة أكثر من عدد أفراد. هذه الجوانب التي يتحقّق منها العميل قبل إرساء العقد.
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-12">
          {operations.map((op) => {
            const Icon = op.icon;
            return (
              <figure class={`${op.span} flex flex-col`}>
                <div class="slot aspect-[4/3] min-h-[220px] flex-1">
                  <p class="slot-label">{op.slot}</p>
                </div>
                <figcaption class="mt-5 flex items-start gap-3">
                  <Icon size={20} class="mt-0.5 shrink-0 text-secondary-500" aria-hidden="true" />
                  <span>
                    <span class="block font-heading text-[1.05rem] font-semibold text-primary-500">
                      {op.title}
                    </span>
                    <span class="mt-1 block max-w-[46ch] text-[0.9rem] leading-relaxed text-ink-muted">
                      {op.description}
                    </span>
                  </span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Sectors -->
    <section class="section-padding bg-paper">
      <div class="container-custom">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="font-heading text-[2rem] font-bold leading-tight text-primary-500 md:text-[2.3rem]">
              القطاعات التي نخدمها
            </h2>
            <p class="mt-5 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
              تختلف متطلبات العمالة بحسب القطاع. فريق التوظيف لدينا منظّم وفق القطاعات التي نوفّر
              لها العمالة.
            </p>
          </div>
          <div class="lg:col-span-8">
            <ul class="grid grid-cols-2 border-t border-rule sm:grid-cols-3">
              {industries.map((industry) => (
                <li class="border-b border-rule px-1 py-5">
                  <span class="font-heading text-[1rem] font-semibold text-primary-500">
                    {industry.titleAr}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="relative overflow-hidden border-t border-rule bg-primary-900">
      <div class="grain absolute inset-0 grid-tex opacity-50" aria-hidden="true"></div>
      <div class="container-custom relative section-padding">
        <div class="grid items-center gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <h2 class="font-heading text-[1.9rem] font-bold leading-tight text-white md:text-[2.2rem]">
              أخبرنا بالمهن والعدد المطلوب.
            </h2>
            <p class="mt-4 max-w-measure text-[0.95rem] leading-relaxed text-white/60">
              أرسل متطلباتك وسيعود إليك فريقنا بالتوافر والجدول الزمني والمستندات.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
            <a href="/en/contact" class="btn-gold">
              طلب عمالة
              <ArrowRight size={18} class="rotate-180" aria-hidden="true" />
            </a>
            <a
              href="https://wa.me/97455019646?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D8%AE%D8%AF%D9%85%D8%A7%D8%AA%20%D8%AA%D9%88%D8%B1%D9%8A%D8%AF%20%D8%A7%D9%84%D8%B9%D9%85%D8%A7%D9%84%D8%A9"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
            >
              تواصل على واتساب
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="ar" client:load />
  <WhatsAppButton lang="ar" client:load />
</BaseLayout>
