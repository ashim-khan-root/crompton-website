---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import ContactForm from '../../components/ContactForm.tsx';
import PageHeader from '../../components/PageHeader.astro';
import { Phone, Mail, MapPin, MessageCircle, Clock } from 'lucide-react';
---

<BaseLayout
  title="Contact"
  description="Contact Crompton International in Doha, Qatar. Call +974 4468 1414, WhatsApp +974 5501 9646, or email info@cromptonqatar.com to request manpower."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Contact"
      lead="Send your workforce requirement and our team will come back with availability, timelines and documentation."
      context="Doha, Qatar · Sun–Thu"
    />

    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <!-- Details -->
          <div class="lg:col-span-5">
            <h2 class="font-heading text-[1.7rem] font-bold leading-snug text-primary-500 md:text-[2rem]">
              Reach us directly
            </h2>

            <dl class="mt-8 border-t border-rule">
              <div class="border-b border-rule py-6">
                <dt class="flex items-center gap-2.5 font-heading text-[0.72rem] uppercase tracking-[0.18em] text-ink-faint">
                  <MapPin size={14} aria-hidden="true" class="text-secondary-500" />
                  Office
                </dt>
                <dd class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">
                  P.O. Box 37491<br />
                  NBK-Msheireb Buildings<br />
                  4th Floor, Office 405 &amp; 406<br />
                  Doha, Qatar
                </dd>
              </div>

              <div class="border-b border-rule py-6">
                <dt class="flex items-center gap-2.5 font-heading text-[0.72rem] uppercase tracking-[0.18em] text-ink-faint">
                  <Phone size={14} aria-hidden="true" class="text-secondary-500" />
                  Telephone
                </dt>
                <dd class="mt-3">
                  <a href="tel:+97444681414" class="tnum font-heading text-[1.15rem] font-semibold text-primary-500 transition-colors duration-150 hover:text-secondary-600">
                    +974 4468 1414
                  </a>
                </dd>
              </div>

              <div class="border-b border-rule py-6">
                <dt class="flex items-center gap-2.5 font-heading text-[0.72rem] uppercase tracking-[0.18em] text-ink-faint">
                  <MessageCircle size={14} aria-hidden="true" class="text-secondary-500" />
                  WhatsApp
                </dt>
                <dd class="mt-3">
                  <a
                    href="https://wa.me/97455019646"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tnum font-heading text-[1.15rem] font-semibold text-primary-500 transition-colors duration-150 hover:text-secondary-600"
                  >
                    +974 5501 9646
                  </a>
                </dd>
              </div>

              <div class="border-b border-rule py-6">
                <dt class="flex items-center gap-2.5 font-heading text-[0.72rem] uppercase tracking-[0.18em] text-ink-faint">
                  <Mail size={14} aria-hidden="true" class="text-secondary-500" />
                  Email
                </dt>
                <dd class="mt-3">
                  <a href="mailto:info@cromptonqatar.com" class="font-heading text-[1.15rem] font-semibold text-primary-500 transition-colors duration-150 hover:text-secondary-600">
                    info@cromptonqatar.com
                  </a>
                </dd>
              </div>

              <div class="py-6">
                <dt class="flex items-center gap-2.5 font-heading text-[0.72rem] uppercase tracking-[0.18em] text-ink-faint">
                  <Clock size={14} aria-hidden="true" class="text-secondary-500" />
                  Working hours
                </dt>
                <dd class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">
                  Sunday &ndash; Thursday, 8:00 &ndash; 17:00<br />
                  Friday &ndash; Saturday: closed
                </dd>
              </div>
            </dl>

            <div class="mt-8 overflow-hidden border border-rule">
              <iframe
                src="https://www.google.com/maps?q=Msheireb,Doha,Qatar&output=embed"
                width="100%"
                height="260"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Crompton International office location, Doha"
              ></iframe>
            </div>
          </div>

          <!-- Form -->
          <div class="lg:col-span-7">
            <div class="border border-rule bg-paper-2 p-6 md:p-10">
              <h2 class="font-heading text-[1.5rem] font-bold text-primary-500">
                Send a requirement
              </h2>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-ink-muted">
                Fields marked <span class="text-secondary-600">*</span> are required.
              </p>
              <div class="mt-8">
                <ContactForm lang="en" type="contact" client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
