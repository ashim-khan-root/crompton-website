---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import jobs from '../../data/jobs.json';
import { Briefcase, MapPin, Clock, ArrowRight, MessageCircle, Upload } from 'lucide-react';
---

<BaseLayout
  title="Careers"
  description="Join Crompton International - explore career opportunities and apply for white collar and blue collar positions in Qatar."
>
  <Navbar lang="en"  client:load />
  
  <!-- Hero -->
  <section class="pt-32 pb-16 bg-gradient-to-br from-primary-900 to-primary-700">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">
          Join Our Team
        </h1>
        <p class="text-xl text-gray-300">
          Explore career opportunities with Crompton International
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Apply -->
  <section class="py-12 bg-secondary-400">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-white">
          <h2 class="text-2xl font-heading font-bold mb-2">Want to Apply Quickly?</h2>
          <p>Send your CV directly via WhatsApp</p>
        </div>
        <a
          href="https://wa.me/97455019646?text=Hello%20Crompton%2C%20I%20would%20like%20to%20apply%20for%20a%20position.%20Here%20is%20my%20CV."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white text-secondary-500 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors"
        >
          <MessageCircle size={20} />
          Apply via WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Job Listings -->
  <section class="py-20">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="mb-12">
        <h2 class="text-3xl font-heading font-bold text-gray-900 mb-4">
          Current Vacancies
        </h2>
        <p class="text-gray-600">
          Apply now for available positions
        </p>
      </div>
      
      <div class="space-y-6">
        {jobs.map((job) => (
          <div class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class:list={[
                    "px-3 py-1 rounded-full text-xs font-medium",
                    job.category === 'White Collar'
                      ? "bg-blue-100 text-blue-700"
                      : "bg-green-100 text-green-700"
                  ]}>
                    {job.category}
                  </span>
                  <span class="text-gray-500 text-sm">{job.type}</span>
                </div>
                
                <h3 class="text-xl font-heading font-semibold text-gray-900 mb-2">
                  {job.title}
                </h3>
                
                <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-3">
                  <span class="flex items-center gap-1">
                    <MapPin size={14} />
                    {job.location}
                  </span>
                  <span class="flex items-center gap-1">
                    <Clock size={14} />
                    {job.experience}
                  </span>
                </div>
                
                <p class="text-gray-600">
                  {job.description}
                </p>
              </div>
              
              <div class="flex-shrink-0">
                <a
                  href={`https://wa.me/97455019646?text=Hello%2C%20I%20would%20like%20to%20apply%20for%20the%20${encodeURIComponent(job.title)}%20position.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-primary-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-600 transition-colors"
                >
                  Apply Now
                  <ArrowRight size={18} />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Application Form -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-heading font-bold text-gray-900 mb-4">
            Submit Your Application
          </h2>
          <p class="text-gray-600">
            Fill out the form below and we'll get back to you
          </p>
        </div>
        
        <form id="application-form" class="bg-white rounded-2xl shadow-lg p-8 space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="app-name" class="block text-sm font-medium text-gray-700 mb-2">
                Full Name *
              </label>
              <input
                type="text"
                id="app-name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all duration-200 outline-none"
                placeholder="Enter your name"
              />
            </div>
            
            <div>
              <label for="app-phone" class="block text-sm font-medium text-gray-700 mb-2">
                Phone Number *
              </label>
              <input
                type="tel"
                id="app-phone"
                name="phone"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all duration-200 outline-none"
                placeholder="+974 XXXX XXXX"
              />
            </div>
          </div>
          
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="app-email" class="block text-sm font-medium text-gray-700 mb-2">
                Email Address *
              </label>
              <input
                type="email"
                id="app-email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all duration-200 outline-none"
                placeholder="your@email.com"
              />
            </div>
            
            <div>
              <label for="app-nationality" class="block text-sm font-medium text-gray-700 mb-2">
                Nationality *
              </label>
              <input
                type="text"
                id="app-nationality"
                name="nationality"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all duration-200 outline-none"
                placeholder="Your nationality"
              />
            </div>
          </div>
          
          <div>
            <label for="app-category" class="block text-sm font-medium text-gray-700 mb-2">
              Job Category *
            </label>
            <select
              id="app-category"
              name="category"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all duration-200 outline-none"
            >
              <option value="">Select category</option>
              <optgroup label="White Collar">
                <option value="project-manager">Project Manager</option>
                <option value="civil-engineer">Civil Engineer</option>
                <option value="mechanical-engineer">Mechanical Engineer</option>
                <option value="electrical-engineer">Electrical Engineer</option>
                <option value="hse-engineer">HSE Engineer</option>
                <option value="qa-qc-engineer">QA/QC Engineer</option>
              </optgroup>
              <optgroup label="Blue Collar">
                <option value="electrician">Electrician</option>
                <option value="plumber">Plumber</option>
                <option value="welder">Welder</option>
                <option value="hvac-technician">HVAC Technician</option>
                <option value="carpenter">Carpenter</option>
                <option value="mason">Mason</option>
                <option value="painter">Painter</option>
                <option value="helper">Helper</option>
              </optgroup>
            </select>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Upload CV (PDF/DOC)
            </label>
            <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-primary-500 transition-colors">
              <Upload size={32} className="mx-auto text-gray-400 mb-3" />
              <p class="text-gray-600 mb-2">Drag and drop your CV here</p>
              <p class="text-gray-500 text-sm">or click to browse</p>
              <input type="file" accept=".pdf,.doc,.docx" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
            </div>
          </div>
          
          <button
            type="submit"
            class="w-full bg-primary-500 text-white px-6 py-4 rounded-lg font-semibold text-lg hover:bg-primary-600 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
          >
            Submit Application
          </button>
        </form>
      </div>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" />
</BaseLayout>

<script>
  const form = document.getElementById('application-form') as HTMLFormElement;
  
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    let message = `Job Application:\n\n`;
    message += `Name: ${data.name}\n`;
    message += `Phone: ${data.phone}\n`;
    message += `Email: ${data.email}\n`;
    message += `Nationality: ${data.nationality}\n`;
    message += `Category: ${data.category}\n`;
    
    const whatsappUrl = `https://wa.me/97455019646?text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, '_blank');
    
    form.reset();
    alert('Application submitted! We will contact you soon.');
  });
</script>
