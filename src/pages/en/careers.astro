---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import jobs from '../../data/jobs.json';
import { MapPin, Clock, ArrowRight, MessageCircle } from 'lucide-react';

const applyHref = (title: string) =>
  `https://wa.me/97455019646?text=${encodeURIComponent(`Job Application — ${title}`)}`;
---

<BaseLayout
  title="Careers"
  description="Current vacancies at Crompton International in Qatar. Apply for white collar professional and blue collar skilled trade positions."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Careers"
      lead="We recruit continuously for our own workforce and for client deployments across Qatar."
      context={`${jobs.length} open roles`}
    />

    <!-- Quick apply -->
    <section class="border-b border-rule bg-paper-2">
      <div class="container-custom px-5 py-8 md:px-8 lg:px-10">
        <div class="flex flex-col gap-5 border-l-2 border-secondary-400 pl-6 md:flex-row md:items-center md:justify-between">
          <div>
            <h2 class="font-heading text-[1.15rem] font-semibold text-primary-500">
              Applying for a trade role?
            </h2>
            <p class="mt-1 text-[0.9rem] text-ink-muted">
              Send your CV direct on WhatsApp and our recruitment team will assess it.
            </p>
          </div>
          <a
            href={applyHref('Trade role — CV submission')}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-navy shrink-0"
          >
            <MessageCircle size={18} aria-hidden="true" />
            Send CV on WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Vacancies -->
    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <h2 class="font-heading text-[1.7rem] font-bold text-primary-500 md:text-[2rem]">
          Current vacancies
        </h2>

        <ul class="mt-10 border-t border-rule">
          {jobs.map((job) => (
            <li class="border-b border-rule py-8">
              <div class="grid gap-6 lg:grid-cols-12 lg:items-start lg:gap-10">
                <div class="lg:col-span-8">
                  <div class="flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.16em] text-ink-faint">
                    <span>{job.category}</span>
                    <span class="h-3 w-px bg-rule" aria-hidden="true"></span>
                    <span>{job.type}</span>
                  </div>

                  <h3 class="mt-3 font-heading text-[1.3rem] font-semibold text-primary-500">
                    {job.title}
                  </h3>

                  <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[0.85rem] text-ink-muted">
                    <span class="inline-flex items-center gap-1.5">
                      <MapPin size={14} aria-hidden="true" class="text-ink-faint" />
                      {job.location}
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <Clock size={14} aria-hidden="true" class="text-ink-faint" />
                      {job.experience} experience
                    </span>
                  </p>

                  <p class="mt-4 max-w-[68ch] text-[0.92rem] leading-relaxed text-ink-muted">
                    {job.description}
                  </p>

                  <ul class="mt-4 grid gap-1.5 text-[0.85rem] text-ink-muted md:grid-cols-2">
                    {job.requirements.map((req) => (
                      <li class="flex gap-2">
                        <span class="mt-2 h-1 w-1 shrink-0 bg-secondary-400" aria-hidden="true"></span>
                        {req}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="lg:col-span-4 lg:text-right">
                  <a
                    href={applyHref(job.title)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-navy"
                  >
                    Apply for this role
                    <ArrowRight size={17} aria-hidden="true" />
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Application form -->
    <section class="border-t border-rule bg-paper-2">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <h2 class="font-heading text-[1.7rem] font-bold leading-snug text-primary-500 md:text-[2rem]">
              Submit your application
            </h2>
            <p class="mt-5 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
              Send your details and we will open a WhatsApp chat with our recruitment team. Attach
              your CV in that chat.
            </p>
          </div>

          <div class="lg:col-span-7">
            <form id="application-form" class="border border-rule bg-paper p-6 md:p-8">
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <label for="app-name" class="mb-2 block text-[0.85rem] font-medium text-ink">
                    Full name <span class="text-secondary-600">*</span>
                  </label>
                  <input type="text" id="app-name" name="name" required class="input-field" placeholder="Your full name" />
                </div>
                <div>
                  <label for="app-phone" class="mb-2 block text-[0.85rem] font-medium text-ink">
                    Phone <span class="text-secondary-600">*</span>
                  </label>
                  <input type="tel" id="app-phone" name="phone" required class="input-field" placeholder="+974 XXXX XXXX" />
                </div>
                <div>
                  <label for="app-email" class="mb-2 block text-[0.85rem] font-medium text-ink">
                    Email
                  </label>
                  <input type="email" id="app-email" name="email" class="input-field" placeholder="your@email.com" />
                </div>
                <div>
                  <label for="app-nationality" class="mb-2 block text-[0.85rem] font-medium text-ink">
                    Nationality
                  </label>
                  <input type="text" id="app-nationality" name="nationality" class="input-field" placeholder="Your nationality" />
                </div>
              </div>

              <div class="mt-5">
                <label for="app-category" class="mb-2 block text-[0.85rem] font-medium text-ink">
                  Category <span class="text-secondary-600">*</span>
                </label>
                <select id="app-category" name="category" required class="input-field">
                  <option value="">Select a category</option>
                  <optgroup label="White collar">
                    <option value="project-manager">Project Manager</option>
                    <option value="civil-engineer">Civil Engineer</option>
                    <option value="mechanical-engineer">Mechanical Engineer</option>
                    <option value="electrical-engineer">Electrical Engineer</option>
                    <option value="hse-engineer">HSE Engineer</option>
                    <option value="qa-qc-engineer">QA/QC Engineer</option>
                  </optgroup>
                  <optgroup label="Blue collar">
                    <option value="electrician">Electrician</option>
                    <option value="plumber">Plumber</option>
                    <option value="welder">Welder</option>
                    <option value="hvac-technician">HVAC Technician</option>
                    <option value="carpenter">Carpenter</option>
                    <option value="mason">Mason</option>
                    <option value="painter">Painter</option>
                    <option value="helper">Helper</option>
                  </optgroup>
                </select>
              </div>

              <div class="mt-5">
                <label for="app-role" class="mb-2 block text-[0.85rem] font-medium text-ink">
                  Role applying for
                </label>
                <input type="text" id="app-role" name="role" class="input-field" placeholder="e.g. HVAC Technician" />
              </div>

              <p class="mt-5 text-[0.8rem] leading-relaxed text-ink-faint">
                Submitting opens WhatsApp with your details pre-filled. Attach your CV in the chat
                before sending. We keep applications on file for future vacancies.
              </p>

              <button type="submit" class="btn-navy mt-6 w-full">
                Continue on WhatsApp
                <ArrowRight size={18} aria-hidden="true" />
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>

<script>
  const form = document.getElementById('application-form') as HTMLFormElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const data = Object.fromEntries(new FormData(form).entries());

    let message = 'Job Application\n\n';
    message += `Name: ${data.name}\n`;
    message += `Phone: ${data.phone}\n`;
    if (data.email) message += `Email: ${data.email}\n`;
    if (data.nationality) message += `Nationality: ${data.nationality}\n`;
    message += `Category: ${data.category}\n`;
    if (data.role) message += `Role: ${data.role}\n`;
    message += '\n(CV attached below)';

    window.open(`https://wa.me/97455019646?text=${encodeURIComponent(message)}`, '_blank');
    form.reset();
  });
</script>
