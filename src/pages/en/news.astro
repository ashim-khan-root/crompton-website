---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ArrowRight } from 'lucide-react';

// NOTE: placeholder entries. Dates, figures and certification claims are
// unverified and must be replaced with client-confirmed copy before launch.
// Headlines assert nothing unverified — no headcount figures, no certification
// claims. They exist to demonstrate the layout, not to state facts.
const posts = [
  {
    date: '2026-01-15',
    category: 'Company news',
    title: 'Workforce expansion across construction and industrial sectors',
    excerpt:
      'Our workforce continues to grow to serve clients across Qatar\u2019s construction and industrial sectors.',
  },
  {
    date: '2025-12-01',
    category: 'Safety',
    title: 'New safety training programme for field workers',
    excerpt:
      'A safety training programme covering induction and safe working practice for field workers.',
  },
  {
    date: '2025-10-15',
    category: 'Pre-qualification',
    title: 'Certification pack available to client HSE teams',
    excerpt:
      'Registrations, licences and certification are shared with client HSE teams during pre-qualification.',
  },
];
---

<BaseLayout
  title="News"
  description="News and updates from Crompton International Trading & Contracting Company W.L.L."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="News &amp; updates"
      lead="Company announcements and industry notes."
      context={`${posts.length} entries`}
    />

    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="mb-10 border-l-2 border-secondary-400 pl-5">
          <p class="text-[0.85rem] leading-relaxed text-ink-muted">
            <span class="font-medium text-ink">Sample content.</span>
            These entries are placeholders. Dates, figures and certification claims need to be
            confirmed with Crompton International before launch — see <span class="tnum">SHOOT-LIST.md §5</span>.
          </p>
        </div>

        <ul class="border-t border-rule">
          {posts.map((post) => (
            <li>
              <article class="border-b border-rule py-8">
                <div class="grid gap-6 lg:grid-cols-12 lg:gap-10">
                  <div class="lg:col-span-3">
                    <time datetime={post.date} class="tnum block font-heading text-[0.8rem] uppercase tracking-[0.14em] text-ink-faint">
                      {new Date(post.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
                    </time>
                    <span class="mt-2 inline-block text-[0.75rem] uppercase tracking-[0.14em] text-secondary-600">
                      {post.category}
                    </span>
                  </div>

                  <div class="lg:col-span-9">
                    <h2 class="font-heading text-[1.3rem] font-semibold text-primary-500">
                      {post.title}
                    </h2>
                    <p class="mt-3 max-w-[68ch] text-[0.92rem] leading-relaxed text-ink-muted">
                      {post.excerpt}
                    </p>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBand
      title="Looking for a workforce partner?"
      body="Skip the reading. Send us the requirement and we will respond with availability and timelines."
      primaryLabel="Request Manpower"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
