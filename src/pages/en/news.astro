---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import { Calendar, ArrowRight } from 'lucide-react';

const posts = [
  {
    date: '2026-01-15',
    title: 'Crompton International Expands Workforce to 800+ Professionals',
    excerpt: 'We are proud to announce that our workforce has grown to over 800 skilled professionals, serving clients across Qatar\'s construction and industrial sectors.',
    category: 'Company News'
  },
  {
    date: '2025-12-01',
    title: 'New Safety Training Program Launched',
    excerpt: 'Crompton International has launched a comprehensive safety training program for all field workers, reinforcing our commitment to workplace safety.',
    category: 'Safety'
  },
  {
    date: '2025-10-15',
    title: 'ISO 45001:2018 Certification Achieved',
    excerpt: 'We are pleased to announce our achievement of ISO 45001:2018 certification for Occupational Health and Safety Management.',
    category: 'Certification'
  }
];
---

<BaseLayout
  title="News & Updates"
  description="Latest news and updates from Crompton International Trading & Contracting."
>
  <Navbar lang="en"  client:load />
  
  <section class="pt-32 pb-16 bg-gradient-to-br from-primary-900 to-primary-700">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">News & Updates</h1>
        <p class="text-xl text-gray-300">Company news and industry insights</p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
            <div class="flex items-center gap-3 mb-4">
              <span class="bg-primary-100 text-primary-600 px-3 py-1 rounded-full text-sm font-medium">
                {post.category}
              </span>
              <span class="flex items-center gap-1 text-gray-500 text-sm">
                <Calendar size={14} />
                {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
            <h2 class="text-2xl font-heading font-semibold text-gray-900 mb-3">
              {post.title}
            </h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              {post.excerpt}
            </p>
            <a href="#" class="inline-flex items-center gap-2 text-primary-500 font-semibold hover:text-primary-600 transition-colors">
              Read More <ArrowRight size={18} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" />
</BaseLayout>
