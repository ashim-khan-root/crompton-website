---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Target, Eye, Shield, Award, Users, Heart, Handshake, Clock } from 'lucide-react';

const values = [
  { icon: Shield, title: 'Safety first', description: 'We prioritise the safety of our workforce and comply with Qatar labour regulations.' },
  { icon: Award, title: 'Quality workforce', description: 'Thorough screening and vetting, so only qualified professionals reach your site.' },
  { icon: Users, title: 'Client focus', description: 'We work to each client\u2019s operational requirements, not a fixed template.' },
  { icon: Heart, title: 'Integrity', description: 'Transparent and honest practice in every dealing.' },
  { icon: Handshake, title: 'Long-term partnerships', description: 'Relationships built on delivery, not on the first contract.' },
  { icon: Clock, title: 'Quick mobilization', description: 'Fast deployment to meet project timelines.' },
];

const reasons = [
  { title: 'Experienced recruitment team', description: 'Recruiters who know the trades and certifications each sector requires.' },
  { title: 'Screened, dependable workforce', description: 'Workers verified against your project requirements before deployment.' },
  { title: 'Quick mobilization', description: 'Deployment planned around your programme, not ours.' },
  { title: 'Competitive commercial terms', description: 'Cost-effective supply without cutting corner on screening or safety.' },
  { title: 'Safety-conscious workforce', description: 'Inducted and trained in Qatar labour and site safety requirements.' },
  { title: 'Dedicated point of contact', description: 'One accountable contact for requests, replacements and documentation.' },
];
---

<BaseLayout
  title="About us"
  description="Cromton Group Trading & Contracting & Services W.L.L. supplies managed workforce to construction, engineering, infrastructure and corporate clients across Qatar."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="About Cromton Group"
      lead="A Qatar-based manpower supplier to the construction, engineering, infrastructure and corporate sectors."
      context="Doha, Qatar"
    />

    <!-- Introduction -->
    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <h2 class="font-heading text-[1.7rem] font-bold leading-snug text-primary-500 md:text-[2rem]">
              What we do
            </h2>
            <div class="mt-6 space-y-5 text-[0.98rem] leading-relaxed text-ink-muted">
              <p>
                Cromton Group Trading &amp; Contracting &amp; Services W.L.L. supplies
                workforce that helps clients complete projects safely, efficiently and on schedule.
              </p>
              <p>
                Our personnel cover qualified engineers, supervisors, technicians, skilled tradesmen
                and general workers &mdash; selected and deployed against each client&rsquo;s
                operational requirements rather than from a fixed roster.
              </p>
              <p>
                We build the relationship around delivery: responsive service, traceable screening
                documentation, and compliance with Qatar labour and site safety requirements.
              </p>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="slot aspect-[4/3] lg:aspect-[5/4]">
              <p class="slot-label">
                Photograph — office reception or recruitment team at work<br />
                <span class="normal-case tracking-normal">1600 × 2000 · SHOOT-LIST.md §H</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision & mission -->
    <section class="border-t border-rule bg-paper-2">
      <div class="container-custom px-5 py-14 md:px-8 md:py-16 lg:px-10">
        <div class="grid gap-6 md:grid-cols-2 lg:gap-10">
          <div class="border border-rule bg-paper p-8 lg:p-10">
            <Eye size={22} className="text-secondary-500" aria-hidden="true" />
            <h2 class="mt-5 font-heading text-[1.35rem] font-bold text-primary-500">Our vision</h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">
              To be a manpower partner Qatar&rsquo;s contractors return to &mdash; recognised for
              quality, reliability and safety.
            </p>
          </div>

          <div class="border border-rule bg-paper p-8 lg:p-10">
            <Target size={22} className="text-secondary-500" aria-hidden="true" />
            <h2 class="mt-5 font-heading text-[1.35rem] font-bold text-primary-500">Our mission</h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">
              To supply skilled, dependable workforce that lets our clients deliver their projects
              safely, on time and within budget.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="border-t border-rule bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <h2 class="font-heading text-[1.7rem] font-bold text-primary-500 md:text-[2rem]">
          What drives us
        </h2>

        <ul class="mt-10 grid border-t border-rule md:grid-cols-2 lg:grid-cols-3 lg:gap-x-14">
          {values.map((value) => {
            const Icon = value.icon;
            return (
              <li class="border-b border-rule py-7">
                <div class="flex items-center gap-3">
                  <Icon size={19} className="shrink-0 text-secondary-500" aria-hidden="true" />
                  <h3 class="font-heading text-[1.08rem] font-semibold text-primary-500">
                    {value.title}
                  </h3>
                </div>
                <p class="mt-3 max-w-[42ch] text-[0.9rem] leading-relaxed text-ink-muted">
                  {value.description}
                </p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- Why choose us -->
    <section class="border-t border-rule bg-paper-2">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <h2 class="font-heading text-[1.7rem] font-bold text-primary-500 md:text-[2rem]">
          Why clients work with us
        </h2>

        <ol class="mt-10 grid border-t border-rule md:grid-cols-2 md:gap-x-16">
          {reasons.map((reason, index) => (
            <li class="flex gap-5 border-b border-rule py-7">
              <span class="tnum shrink-0 font-heading text-[0.95rem] font-bold text-secondary-500">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>
                <h3 class="font-heading text-[1.08rem] font-semibold text-primary-500">
                  {reason.title}
                </h3>
                <p class="mt-2 max-w-[48ch] text-[0.9rem] leading-relaxed text-ink-muted">
                  {reason.description}
                </p>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <CtaBand />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
