---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import { Shield, HardHat, ClipboardCheck, AlertTriangle, BookOpen, Award } from 'lucide-react';

const commitments = [
  {
    icon: Shield,
    title: 'Safety Policy',
    description: 'Comprehensive health and safety policy covering all aspects of workforce operations in compliance with Qatar Labour Law.'
  },
  {
    icon: HardHat,
    title: 'PPE Provision',
    description: 'All workers provided with appropriate Personal Protective Equipment (PPE) for their specific job requirements.'
  },
  {
    icon: ClipboardCheck,
    title: 'Safety Training',
    description: 'Mandatory safety induction training for all workers before deployment to client sites.'
  },
  {
    icon: AlertTriangle,
    title: 'Risk Assessment',
    description: 'Regular risk assessments and safety audits to identify and mitigate workplace hazards.'
  },
  {
    icon: BookOpen,
    title: 'Incident Reporting',
    description: 'Robust incident reporting and investigation system to prevent recurrence of accidents.'
  },
  {
    icon: Award,
    title: 'Quality Management',
    description: 'ISO-compliant quality management systems to ensure consistent service delivery.'
  }
];
---

<BaseLayout
  title="Health, Safety & Environment"
  description="Crompton International's commitment to health, safety, and environmental standards in workforce management."
>
  <Navbar lang="en"  client:load />
  
  <!-- Hero -->
  <section class="pt-32 pb-16 bg-gradient-to-br from-primary-900 to-primary-700">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">
          Health, Safety & Environment
        </h1>
        <p class="text-xl text-gray-300">
          Our commitment to safety standards and compliance
        </p>
      </div>
    </div>
  </section>

  <!-- Safety Statement -->
  <section class="py-20">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-heading font-bold text-gray-900 mb-6">
          Our Safety Commitment
        </h2>
        <p class="text-gray-600 leading-relaxed text-lg">
          At Crompton International, safety is not just a policy — it's a core value. We are committed to providing a safe and healthy working environment for all our employees and stakeholders. Our safety management system is designed to prevent accidents, protect health, and minimize environmental impact.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {commitments.map((item) => {
          const Icon = item.icon;
          return (
            <div class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
              <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mb-6">
                <Icon size={28} className="text-primary-500" />
              </div>
              <h3 class="font-heading font-semibold text-xl text-gray-900 mb-3">
                {item.title}
              </h3>
              <p class="text-gray-600 leading-relaxed">
                {item.description}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Key Stats -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-heading font-bold text-secondary-400 mb-2">0</div>
          <p class="text-gray-600 font-medium">Lost Time Injuries</p>
        </div>
        <div>
          <div class="text-4xl font-heading font-bold text-secondary-400 mb-2">100%</div>
          <p class="text-gray-600 font-medium">Safety Training</p>
        </div>
        <div>
          <div class="text-4xl font-heading font-bold text-secondary-400 mb-2">100%</div>
          <p class="text-gray-600 font-medium">PPE Compliance</p>
        </div>
        <div>
          <div class="text-4xl font-heading font-bold text-secondary-400 mb-2">24/7</div>
          <p class="text-gray-600 font-medium">Safety Support</p>
        </div>
      </div>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" />
</BaseLayout>
