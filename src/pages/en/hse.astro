---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Shield, HardHat, ClipboardCheck, AlertTriangle, BookOpen, Award } from 'lucide-react';

const commitments = [
  {
    icon: Shield,
    title: 'Safety policy',
    description: 'A health and safety policy covering all workforce operations, aligned with Qatar Labour Law.',
  },
  {
    icon: HardHat,
    title: 'PPE provision',
    description: 'Every worker is issued appropriate personal protective equipment for their specific job.',
  },
  {
    icon: ClipboardCheck,
    title: 'Safety training',
    description: 'Mandatory induction training is completed before any worker is deployed to a client site.',
  },
  {
    icon: AlertTriangle,
    title: 'Risk assessment',
    description: 'Regular risk assessments and safety audits to identify and mitigate workplace hazards.',
  },
  {
    icon: BookOpen,
    title: 'Incident reporting',
    description: 'Incident reporting and investigation procedures designed to prevent recurrence.',
  },
  {
    icon: Award,
    title: 'Quality management',
    description: 'Quality management procedures to keep service delivery consistent across deployments.',
  },
];
---

<BaseLayout
  title="Health, Safety & Environment"
  description="Cromton Group's health, safety and environmental standards across workforce supply and deployment in Qatar."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Health, Safety &amp; Environment"
      lead="Safety is a condition of supply, not a claim on a page. Every worker is inducted and equipped before reaching your site."
      context="HSE · Qatar Labour Law"
    />

    <!-- Statement -->
    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <h2 class="font-heading text-[1.7rem] font-bold leading-snug text-primary-500 md:text-[2rem]">
              Our safety commitment
            </h2>
            <p class="mt-5 max-w-measure text-[0.98rem] leading-relaxed text-ink-muted">
              We provide a safe and healthy working environment for our employees and for the sites
              they work on. Our procedures are built to prevent accidents, protect health and
              minimise environmental impact &mdash; and to produce the documentation a client's HSE
              team will ask for.
            </p>
          </div>

          <div class="lg:col-span-5">
            <div class="slot aspect-[4/3]">
              <p class="slot-label">
                Photograph — toolbox talk or safety briefing<br />
                <span class="normal-case tracking-normal">1600 × 1200 · SHOOT-LIST.md §F</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Commitments -->
    <section class="border-t border-rule bg-paper-2">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <h2 class="font-heading text-[1.7rem] font-bold text-primary-500 md:text-[2rem]">
          How we manage it
        </h2>

        <ul class="mt-10 grid border-t border-rule md:grid-cols-2 lg:grid-cols-3 lg:gap-x-14">
          {commitments.map((item) => {
            const Icon = item.icon;
            return (
              <li class="border-b border-rule py-7">
                <div class="flex items-center gap-3">
                  <Icon size={19} className="shrink-0 text-secondary-500" aria-hidden="true" />
                  <h3 class="font-heading text-[1.08rem] font-semibold text-primary-500">
                    {item.title}
                  </h3>
                </div>
                <p class="mt-3 max-w-[42ch] text-[0.9rem] leading-relaxed text-ink-muted">
                  {item.description}
                </p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <CtaBand
      title="Add us to your pre-qualification list."
      body="Send your HSE questionnaire and we will return the completed pack — safety policy, risk assessments, training records and certification."
      primaryLabel="Request the HSE pack"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
