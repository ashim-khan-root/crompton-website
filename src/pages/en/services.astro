---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import services from '../../data/services.json';

// Photographs exist for five of the six services. Recruitment keeps its labelled
// placeholder rather than borrowing an image of something else.
const serviceImages: Record<string, { src: string; alt: string }> = {
  'white-collar': {
    src: '/images/services/white-collar.webp',
    alt: 'Engineers reviewing structural drawings around a table in a Doha office',
  },
  'blue-collar': {
    src: '/images/services/blue-collar.webp',
    alt: 'Skilled worker using an angle grinder with full protective equipment',
  },
  'project-based': {
    src: '/images/services/project-based.webp',
    alt: 'Steel fixers working on a reinforcement deck',
  },
  outsourcing: {
    src: '/images/services/outsourcing.webp',
    alt: 'Plasterer finishing an internal wall',
  },
  payroll: {
    src: '/images/services/payroll.webp',
    alt: 'Payroll desk with a stack of payslips, a calculator and a blurred spreadsheet on screen',
  },
};
---

<BaseLayout
  title="Services"
  description="Workforce supply services from Crompton International in Qatar: white collar staffing, blue collar manpower, project-based workforce, recruitment and mobilization, outsourcing, and payroll support."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Services"
      lead="Six workforce services, delivered as one mobilization capability. Scope is set by your project, not a fixed catalogue."
      context="Six services · Doha, Qatar"
    />

    <section class="bg-paper">
      <div class="container-custom px-5 md:px-8 lg:px-10">
        {services.map((service) => (
          <article
            id={service.id}
            class="grid gap-10 border-t border-rule py-14 lg:grid-cols-12 lg:gap-12 lg:py-16"
          >
            <div class="lg:col-span-4">
              <h2 class="font-heading text-[1.55rem] font-bold leading-snug text-primary-500 md:text-[1.75rem]">
                {service.title}
              </h2>
              <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-muted">
                {service.description}
              </p>
              <a
                href="/en/contact"
                class="mt-6 inline-flex items-center gap-2 border-b border-primary-500 pb-1 font-heading text-[0.88rem] font-semibold text-primary-500 transition-colors duration-150 hover:border-secondary-400 hover:text-secondary-600"
              >
                Request this service
              </a>
            </div>

            <div class="lg:col-span-4">
              <h3 class="font-heading text-[0.72rem] uppercase tracking-[0.18em] text-ink-faint">
                Roles covered
              </h3>
              <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-2.5 text-[0.88rem] leading-snug text-ink-muted">
                {service.roles.map((role) => (
                  <li>{role}</li>
                ))}
              </ul>
            </div>

            <div class="lg:col-span-4">
              <Photo
                src={serviceImages[service.id]?.src}
                alt={serviceImages[service.id]?.alt}
                label={`Photograph — ${service.title} · SHOOT-LIST.md`}
                class="aspect-[4/3]"
              />
            </div>
          </article>
        ))}
      </div>
    </section>

    <CtaBand
      title="Need a custom workforce solution?"
      body="Tell us the trades, the headcount and the timeline. Our team will design the deployment around your project."
      primaryLabel="Discuss your requirement"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
