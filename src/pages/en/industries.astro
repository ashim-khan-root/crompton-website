---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import industries from '../../data/industries.json';
---

<BaseLayout
  title="Industries"
  description="Cromton Group supplies workforce across Qatar's construction, engineering, infrastructure, oil and gas support, MEP, facility management, manufacturing, logistics, hospitality, corporate, retail, and healthcare sectors."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Industries we serve"
      lead="Workforce requirements differ by sector. Our recruitment team is organised around the industries we place into."
      context="Twelve sectors"
    />

    <section class="bg-paper">
      <div class="container-custom px-5 py-12 md:px-8 md:py-16 lg:px-10">
        <ul class="grid border-t border-rule md:grid-cols-2 md:gap-x-16">
          {industries.map((industry) => (
            <li class="border-b border-rule py-7">
              <h2 class="font-heading text-[1.2rem] font-semibold text-primary-500">
                {industry.title}
              </h2>
              <p class="mt-2 max-w-[52ch] text-[0.9rem] leading-relaxed text-ink-muted">
                {industry.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-paper-2">
      <Photo
        src="/images/industries/site.webp"
        alt="Construction site in Qatar with tower crane and scaffolding"
        class="aspect-[16/9] w-full sm:aspect-[21/9]"
      />
    </section>

    <CtaBand
      title="Industry-specific workforce solutions"
      body="Each sector carries its own labour requirements and compliance obligations. Tell us yours and we will scope the deployment."
      primaryLabel="Discuss your requirement"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
