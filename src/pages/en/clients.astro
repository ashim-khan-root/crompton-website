---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import clients from '../../data/clients.json';

const sorted = [...clients].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="Clients"
  description="Companies across Qatar that Cromton Group supplies workforce to, including contractors, engineering firms, MEP specialists and facilities management providers."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Clients"
      lead="We supply workforce to construction, engineering, oil and gas, MEP and facilities management companies across Qatar."
      context={sorted.length ? `${sorted.length} clients` : 'References on request'}
    />

    <section class="bg-paper-2">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        {sorted.length > 0 ? (
          <>
            <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
              {sorted.map((client) => (
                <li class="flex flex-col items-center justify-center gap-4 bg-white px-5 py-7">
                  <img
                    src={client.logo}
                    alt={`${client.name} logo`}
                    loading="lazy"
                    decoding="async"
                    class="max-h-16 w-auto max-w-full object-contain"
                  />
                  <span class="text-center text-[0.76rem] leading-snug text-ink-muted">
                    {client.name}
                  </span>
                </li>
              ))}
            </ul>

            <p class="mt-8 max-w-measure text-[0.82rem] leading-relaxed text-ink-faint">
              Logos are the property of their respective owners and are shown to identify companies
              we have supplied. Project references are shared on request, in line with our
              confidentiality obligations.
            </p>
          </>
        ) : (
          <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-5">
              <h2 class="font-heading text-[1.7rem] font-bold leading-snug text-primary-500 md:text-[2rem]">
                Client references
              </h2>
              <p class="mt-5 max-w-measure text-[0.98rem] leading-relaxed text-ink-muted">
                Because of contractual confidentiality, we share client names and project
                references directly rather than listing them publicly.
              </p>
              <a href="/en/contact" class="mt-7 inline-flex items-center gap-2 border-b border-primary-500 pb-1 font-heading text-[0.9rem] font-semibold text-primary-500 transition-colors duration-150 hover:border-secondary-400 hover:text-secondary-600">
                Request references
              </a>
            </div>
          </div>
        )}
      </div>
    </section>

    <CtaBand
      title="Become our next reference."
      body="Tell us your workforce requirement and we will put you in touch with clients we already supply in your sector."
      primaryLabel="Start a conversation"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
