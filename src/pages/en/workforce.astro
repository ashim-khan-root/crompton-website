---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import workforce from '../../data/workforce.json';
---

<BaseLayout
  title="Workforce categories"
  description="Available manpower categories from Cromton Group: white collar professionals and blue collar skilled trades for construction, engineering and industrial projects in Qatar."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Workforce categories"
      lead="White collar professionals and blue collar trades, available for individual placement or full project mobilization."
      context={`${workforce.whiteCollar.length} professional roles · ${workforce.blueCollar.length} skilled trades`}
    />

    <!-- Search -->
    <section class="border-b border-rule bg-paper-2">
      <div class="container-custom px-5 py-6 md:px-8 lg:px-10">
        <label for="workforce-search" class="sr-only">Search workforce categories</label>
        <input
          type="text"
          id="workforce-search"
          placeholder="Search categories — e.g. welder, engineer, electrician"
          class="input-field max-w-xl"
        />
      </div>
    </section>

    <!-- White collar -->
    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="mb-10">
          <h2 class="font-heading text-[1.7rem] font-bold text-primary-500">
            White collar professionals
          </h2>
          <p class="mt-3 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
            Engineers, managers and technical staff with verified qualifications and GCC project experience.
          </p>
        </div>

        <ul class="grid border-t border-rule md:grid-cols-2 md:gap-x-16" id="white-collar-list">
          {workforce.whiteCollar.map((item) => (
            <li
              class="workforce-card border-b border-rule py-6"
              data-category={item.category.toLowerCase()}
            >
              <h3 class="font-heading text-[1.1rem] font-semibold text-primary-500">
                {item.category}
              </h3>
              <p class="mt-2 max-w-[52ch] text-[0.9rem] leading-relaxed text-ink-muted">
                {item.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Blue collar -->
    <section class="border-t border-rule bg-paper-2">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="mb-10">
          <h2 class="font-heading text-[1.7rem] font-bold text-primary-500">
            Blue collar workforce
          </h2>
          <p class="mt-3 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
            Skilled trades and general workers, screened and safety-inducted before they reach your site.
          </p>
        </div>

        <ul class="grid border-t border-rule md:grid-cols-2 md:gap-x-16" id="blue-collar-list">
          {workforce.blueCollar.map((item) => (
            <li
              class="workforce-card border-b border-rule py-6"
              data-category={item.category.toLowerCase()}
            >
              <h3 class="font-heading text-[1.1rem] font-semibold text-primary-500">
                {item.category}
              </h3>
              <p class="mt-2 max-w-[52ch] text-[0.9rem] leading-relaxed text-ink-muted">
                {item.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBand
      title="Don't see the trade you need?"
      body="We source outside the listed categories. Tell us the role, the certification level and the headcount."
      primaryLabel="Request custom manpower"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>

<script>
  const searchInput = document.getElementById('workforce-search') as HTMLInputElement;
  const cards = document.querySelectorAll('.workforce-card');

  searchInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const query = target.value.trim().toLowerCase();

    cards.forEach((card) => {
      const category = card.getAttribute('data-category') || '';
      const text = card.textContent?.toLowerCase() || '';
      const match = !query || category.includes(query) || text.includes(query);
      (card as HTMLElement).style.display = match ? '' : 'none';
    });
  });
</script>
