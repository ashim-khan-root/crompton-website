---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import services from '../../data/services.json';
import Photo from '../../components/Photo.astro';
import HeroCarousel from '../../components/HeroCarousel.astro';
import industries from '../../data/industries.json';
import { ArrowRight, Phone, ShieldCheck, Truck, GraduationCap, BedDouble } from 'lucide-react';

const capabilities = services;

// Operations the buyer actually audits before awarding a manpower contract.
const operations = [
  {
    icon: BedDouble,
    title: 'Accommodation',
    description: 'Worker housing maintained to Qatar standards, with transport between camp and site.',
    slot: 'Photograph — accommodation camp, exterior. 1600 × 1200',
    span: 'lg:col-span-7',
  },
  {
    icon: Truck,
    title: 'Transportation',
    description: 'Dedicated fleet for daily mobilization and site rotation.',
    slot: 'Photograph — transport fleet, on site. 1200 × 900',
    image: '/images/gallery/transportation.webp',
    alt: 'Workers boarding a Crompton International bus for site mobilisation in Doha',
    span: 'lg:col-span-5',
  },
  {
    icon: GraduationCap,
    title: 'Training',
    description: 'Trade and safety induction before a worker reaches your project.',
    slot: 'Photograph — training / induction session. 1200 × 900',
    span: 'lg:col-span-5',
  },
  {
    icon: ShieldCheck,
    title: 'Health & Safety',
    description: 'HSE procedures aligned with Qatar labour and site requirements.',
    slot: 'Photograph — HSE briefing with PPE. 1600 × 1200',
    span: 'lg:col-span-7',
  },
];
---

<BaseLayout
  title="Manpower Supply in Qatar"
  description="Crompton International supplies screened white collar and blue collar workforce to construction, engineering and industrial projects across Qatar. Request manpower from Doha."
>
  <Navbar lang="en" client:load />

  <main>
    <!-- ============================================================
         Hero — asymmetric, content-height (never 100vh), solid navy
         ============================================================ -->
    <section class="relative overflow-hidden bg-ground pt-36 pb-20 md:pt-44 md:pb-24">
      <div class="grain absolute inset-0 grid-tex opacity-70" aria-hidden="true"></div>

      <div class="container-custom relative px-5 md:px-8 lg:px-10">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
          <!-- Message -->
          <div class="lg:col-span-7">
            <p class="mb-7 inline-flex items-center gap-2.5 border border-white/15 px-3.5 py-1.5 text-[0.72rem] uppercase tracking-[0.18em] text-white/70">
              <span class="h-1.5 w-1.5 bg-secondary-400"></span>
              Manpower Supply &middot; Doha, Qatar
            </p>

            <h1 class="font-heading text-[2.5rem] font-bold leading-[1.06] text-white sm:text-[3.2rem] lg:text-[3.9rem]">
              Reliable manpower for Qatar&rsquo;s growing industries
            </h1>

            <p class="mt-6 max-w-measure text-[1.05rem] leading-relaxed text-white/65">
              Crompton International supplies screened white collar and blue collar workforce
              to construction, engineering, infrastructure and corporate clients &mdash;
              mobilized to your site, on your schedule.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a href="/en/contact" class="btn-accent">
                Request Manpower
                <ArrowRight size={18} aria-hidden="true" />
              </a>
              <a href="tel:+97444681414" class="btn-ghost">
                <Phone size={17} aria-hidden="true" />
                <span class="tnum">+974 4468 1414</span>
              </a>
            </div>
          </div>

          <!-- Operational snapshot — real structure, no filler card -->
          <div class="lg:col-span-5">
            <div class="border border-white/12 bg-white/[0.03] backdrop-blur-sm">
              <div class="border-b border-white/10 px-6 py-4">
                <h2 class="font-heading text-[0.72rem] uppercase tracking-[0.2em] text-secondary-300">
                  What we supply
                </h2>
              </div>
              <ul>
                {capabilities.map((item) => (
                  <li class="flex items-baseline justify-between gap-6 border-b border-white/10 px-6 py-4 last:border-b-0">
                    <span class="font-heading text-[0.98rem] font-semibold text-white">{item.title}</span>
                    <span class="shrink-0 text-[0.7rem] uppercase tracking-[0.14em] text-white/40">
                      {item.roles.length} roles
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Credibility row -->
        <div class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-white/12 pt-6 text-[0.8rem] text-white/55">
          <span>Licensed by Qatar Ministry of Labour</span>
          <span class="hidden h-3 w-px bg-white/20 sm:block"></span>
          <span>White collar &amp; blue collar supply</span>
          <span class="hidden h-3 w-px bg-white/20 sm:block"></span>
          <span>Project-based mobilization</span>
          <span class="hidden h-3 w-px bg-white/20 lg:block"></span>
          <span>Doha, Qatar</span>
        </div>
      </div>
    </section>

    <!-- ============================================================
         Hero photograph — full-bleed slot. Drop the approved image in.
         ============================================================ -->
    <HeroCarousel lang="en" />

    <!-- ============================================================
         Capabilities — asymmetric ledger, not a card grid
         ============================================================ -->
    <section class="section-padding bg-paper">
      <div class="container-custom">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="font-heading text-[2rem] font-bold leading-tight text-primary-500 md:text-[2.3rem]">
              What we supply
            </h2>
            <p class="mt-5 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
              Six workforce services, delivered as one mobilization capability. Scope is set by
              your project, not by a fixed catalogue.
            </p>
            <a
              href="/en/services"
              class="mt-7 inline-flex items-center gap-2 border-b border-primary-500 pb-1 font-heading text-[0.9rem] font-semibold text-primary-500 transition-colors duration-150 hover:border-secondary-400 hover:text-secondary-600"
            >
              All services
              <ArrowRight size={16} aria-hidden="true" />
            </a>
          </div>

          <div class="lg:col-span-8">
            <ul class="border-t border-rule">
              {capabilities.map((item) => (
                <li>
                  <a
                    href={`/en/services#${item.id}`}
                    class="group grid grid-cols-1 gap-2 border-b border-rule py-6 transition-colors duration-150 hover:bg-paper-2 md:grid-cols-12 md:gap-6 md:px-3"
                  >
                    <span class="font-heading text-[1.15rem] font-semibold text-primary-500 md:col-span-5">
                      {item.title}
                    </span>
                    <span class="text-[0.9rem] leading-relaxed text-ink-muted md:col-span-6">
                      {item.description}
                    </span>
                    <span class="hidden justify-self-end text-ink-faint transition-colors duration-150 group-hover:text-secondary-500 md:col-span-1 md:block">
                      <ArrowRight size={18} aria-hidden="true" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         Operations — what a buyer audits. Photography-led, asymmetric.
         ============================================================ -->
    <section class="section-padding bg-paper-2">
      <div class="container-custom">
        <div class="mb-12 max-w-measure">
          <h2 class="font-heading text-[2rem] font-bold leading-tight text-primary-500 md:text-[2.3rem]">
            Behind every deployment
          </h2>
          <p class="mt-5 text-[0.95rem] leading-relaxed text-ink-muted">
            Manpower is more than a headcount. These are the parts of the operation a client
            checks before awarding a contract.
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-12">
          {operations.map((op) => {
            const Icon = op.icon;
            return (
              <figure class={`${op.span} flex flex-col`}>
                <Photo
                  src={op.image}
                  alt={op.alt}
                  label={op.slot}
                  class="min-h-[220px] flex-1 aspect-[4/3]"
                />
                <figcaption class="mt-5 flex items-start gap-3">
                  <Icon size={20} className="mt-0.5 shrink-0 text-secondary-500" aria-hidden="true" />
                  <span>
                    <span class="block font-heading text-[1.05rem] font-semibold text-primary-500">
                      {op.title}
                    </span>
                    <span class="mt-1 block max-w-[46ch] text-[0.9rem] leading-relaxed text-ink-muted">
                      {op.description}
                    </span>
                  </span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ============================================================
         Sectors — dense index, hairline separated, no boxed cards
         ============================================================ -->
    <section class="section-padding bg-paper">
      <div class="container-custom">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="font-heading text-[2rem] font-bold leading-tight text-primary-500 md:text-[2.3rem]">
              Sectors we serve
            </h2>
            <p class="mt-5 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
              Workforce requirements differ by sector. Our recruitment team is organized around
              the industries we place into.
            </p>
          </div>
          <div class="lg:col-span-8">
            <ul class="grid grid-cols-2 border-t border-rule sm:grid-cols-3">
              {industries.map((industry) => (
                <li class="border-b border-rule px-1 py-5">
                  <span class="font-heading text-[1rem] font-semibold text-primary-500">
                    {industry.title}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         Closing CTA — distinct from the interior pages' band
         ============================================================ -->
    <section class="border-t border-rule bg-paper-2">
      <div class="container-custom section-padding">
        <div class="grid items-center gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <h2 class="font-heading text-[1.9rem] font-bold leading-tight text-primary-500 md:text-[2.2rem]">
              Tell us the roles and the headcount.
            </h2>
            <p class="mt-4 max-w-measure text-[0.95rem] leading-relaxed text-ink-muted">
              Send your requirement and our team will come back with availability, timelines and
              documentation.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
            <a href="/en/contact" class="btn-navy">
              Request Manpower
              <ArrowRight size={18} aria-hidden="true" />
            </a>
            <a href="https://wa.me/97455019646" target="_blank" rel="noopener noreferrer" class="btn border border-rule text-primary-500 hover:border-primary-500">
              Chat on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
