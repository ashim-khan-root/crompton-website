---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import { FileCheck, Award, Shield, Building } from 'lucide-react';

const certificates = [
  { icon: Building, title: 'Commercial Registration', description: 'Valid Commercial Registration with Qatar Chamber of Commerce' },
  { icon: FileCheck, title: 'Manpower License', description: 'Licensed manpower supply company by Qatar Ministry of Labour' },
  { icon: Shield, title: 'ISO 9001:2015', description: 'Quality Management System Certification' },
  { icon: Award, title: 'ISO 14001:2015', description: 'Environmental Management System Certification' },
  { icon: Shield, title: 'ISO 45001:2018', description: 'Occupational Health and Safety Management System' },
  { icon: FileCheck, title: 'Qatar Civil Defence', description: 'Fire Safety and Civil Defence Compliance Certificate' },
];
---

<BaseLayout
  title="Certificates & Licenses"
  description="Crompton International's accreditations, licenses, and compliance certifications."
>
  <Navbar lang="en"  client:load />
  
  <section class="pt-32 pb-16 bg-gradient-to-br from-primary-900 to-primary-700">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">Certificates & Licenses</h1>
        <p class="text-xl text-gray-300">Our accreditations and compliance documents</p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certificates.map((cert) => {
          const Icon = cert.icon;
          return (
            <div class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow text-center">
              <div class="w-16 h-16 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-6">
                <Icon size={32} className="text-primary-500" />
              </div>
              <h3 class="font-heading font-semibold text-xl text-gray-900 mb-3">{cert.title}</h3>
              <p class="text-gray-600">{cert.description}</p>
            </div>
          );
        })}
      </div>
      <p class="text-center text-gray-500 mt-12">
        For copies of certificates, please contact us directly.
      </p>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" />
</BaseLayout>
