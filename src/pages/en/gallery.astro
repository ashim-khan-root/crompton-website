---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import { Camera } from 'lucide-react';

const categories = ['Workers', 'Accommodation', 'Transportation', 'Projects', 'Training', 'Office'];
---

<BaseLayout
  title="Gallery"
  description="View photos of Crompton International's workforce, accommodation, transportation, offices, and projects."
>
  <Navbar lang="en"  client:load />
  
  <section class="pt-32 pb-16 bg-gradient-to-br from-primary-900 to-primary-700">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">Gallery</h1>
        <p class="text-xl text-gray-300">Our workforce, facilities, and projects</p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom mx-auto px-4 md:px-8 lg:px-16">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {categories.map((cat) => (
          <div class="bg-gray-100 rounded-xl aspect-square flex flex-col items-center justify-center p-6 hover:bg-primary-50 transition-colors cursor-pointer">
            <Camera size={32} className="text-gray-400 mb-3" />
            <p class="font-medium text-gray-700 text-center">{cat}</p>
            <p class="text-sm text-gray-500 text-center">Coming Soon</p>
          </div>
        ))}
      </div>
      <p class="text-center text-gray-500 mt-12">
        Gallery photos will be added soon. Contact us for more information about our facilities.
      </p>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" />
</BaseLayout>
