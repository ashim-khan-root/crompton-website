---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';

const categories = [
  { title: 'Workers', description: 'Crews on site, trades at work and supervisory staff.' },
  { title: 'Accommodation', description: 'Worker housing, common areas and welfare provision.' },
  { title: 'Transportation', description: 'The fleet used for daily mobilization and site rotation.' },
  { title: 'Projects', description: 'Completed and in-progress works staffed by Cromton Group.' },
  { title: 'Training', description: 'Trade and safety induction before deployment.' },
  { title: 'Office', description: 'The Doha office and recruitment team.' },
];
---

<BaseLayout
  title="Gallery"
  description="Photographs of Cromton Group's workforce, accommodation, transportation, training, projects and Doha office."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Gallery"
      lead="Our workforce, facilities and operations. Photographs are being supplied by the client — each frame below holds its final position."
      context="Six categories"
    />

    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <figure>
              <div class="slot aspect-[4/3]">
                <p class="slot-label">
                  Photographs — {category.title}<br />
                  <span class="normal-case tracking-normal">1600 × 1200 · SHOOT-LIST.md</span>
                </p>
              </div>
              <figcaption class="mt-4">
                <h2 class="font-heading text-[1.1rem] font-semibold text-primary-500">
                  {category.title}
                </h2>
                <p class="mt-1.5 max-w-[40ch] text-[0.88rem] leading-relaxed text-ink-muted">
                  {category.description}
                </p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      title="Want to see our operation in person?"
      body="We are happy to arrange a site or accommodation visit as part of your due diligence."
      primaryLabel="Arrange a visit"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
