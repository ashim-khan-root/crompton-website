---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
import WhatsAppButton from '../../components/WhatsAppButton.tsx';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';

type Category = { title: string; description: string; image?: string; alt?: string };

const categories: Category[] = [
  {
    title: 'Workers',
    description: 'Trades at work, from electrical to finishing.',
    image: '/images/gallery/workers.webp',
    alt: 'Electrician terminating wiring in a distribution board',
  },
  {
    title: 'Accommodation',
    description: 'Worker housing, common areas and welfare provision.',
    image: '/images/gallery/accommodation.webp',
    alt: 'Two-storey accommodation blocks with external staircases, shaded walkways and planted surrounds',
  },
  {
    title: 'Transportation',
    description: 'The fleet used for daily mobilization and site rotation.',
    image: '/images/gallery/transportation.webp',
    alt: 'Workers boarding a company bus for site rotation in Doha',
  },
  {
    title: 'Projects',
    description: 'Construction work of the kind we staff.',
    image: '/images/gallery/works.webp',
    alt: 'Building under construction with a tower crane overhead',
  },
  {
    title: 'Training',
    description: 'Trade and safety induction before deployment.',
    image: '/images/gallery/training.webp',
    alt: 'Workers in navy coveralls at induction, facing an instructor at a blank whiteboard',
  },
  {
    title: 'Office',
    description: 'The Doha office and recruitment team.',
    image: '/images/gallery/office.webp',
    alt: 'Reception counter at the Doha office, a visitor with a folder at the desk',
  },
];
---

<BaseLayout
  title="Gallery"
  description="Photographs of Crompton International's workforce, accommodation, transportation, training, projects and Doha office."
>
  <Navbar lang="en" client:load />

  <main>
    <PageHeader
      title="Gallery"
      lead="Our workforce, facilities and operations in Doha."
      context="Six categories"
    />

    <section class="bg-paper">
      <div class="container-custom px-5 py-14 md:px-8 md:py-20 lg:px-10">
        <div class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <figure>
              <Photo
                src={category.image}
                alt={category.alt}
                label={`Photographs — ${category.title} · SHOOT-LIST.md`}
                class="aspect-[4/3]"
              />
              <figcaption class="mt-4">
                <h2 class="font-heading text-[1.1rem] font-semibold text-primary-500">
                  {category.title}
                </h2>
                <p class="mt-1.5 max-w-[40ch] text-[0.88rem] leading-relaxed text-ink-muted">
                  {category.description}
                </p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      title="Want to see our operation in person?"
      body="We are happy to arrange a site or accommodation visit as part of your due diligence."
      primaryLabel="Arrange a visit"
    />
  </main>

  <Footer lang="en" client:load />
  <WhatsAppButton lang="en" client:load />
</BaseLayout>
